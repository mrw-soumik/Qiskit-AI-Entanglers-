# Copy this file to .env (same folder) and paste your IBM Quantum credentials after the = signs,
# or put them in api.json as {"apikey": "...", "crn": "..."} like the Fall Fest IBM example.
# Same names as the Fall Fest IBM hardware example. .env is gitignored: never commit or zip it.
apikey=
crn=
# Optional: defaults to ibm_quantum_platform; set a device name (e.g. ibm_quebec) or leave empty for the least busy one
QISKIT_IBM_CHANNEL=ibm_quantum_platform
QISKIT_IBM_BACKEND=
