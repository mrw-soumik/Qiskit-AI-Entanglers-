# Copy this file to .env and fill in your IBM Quantum credentials.
# .env is gitignored and must never be committed or zipped.
QISKIT_IBM_TOKEN=
# Instance CRN from https://quantum.cloud.ibm.com (Instances page)
QISKIT_IBM_INSTANCE=
QISKIT_IBM_CHANNEL=ibm_cloud
# Optional: force a backend (e.g. ibm_fez); leave empty for the least busy one
QISKIT_IBM_BACKEND=
